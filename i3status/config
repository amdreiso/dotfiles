
general {
	colors = true
	interval = 5
}

order += "disk /"
order += "battery all"
order += "memory"
order += "tztime local"

battery all {
        format = "%status %percentage"
}

disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        format = "%used of %total"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        #format = "%Y-%m-%d %H:%M:%S"
		format = "%H:%M %d/%m/%y"
}

